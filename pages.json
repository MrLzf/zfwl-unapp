{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^s-(.*)": "@/sheep/components/s-$1/s-$1.vue",
      "^su-(.*)": "@/sheep/ui/su-$1/su-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "aliasPath": "/",
      "style": {
        "navigationBarTitleText": "家教首页",
        "enablePullDownRefresh": true
      },
      "meta": {
        "auth": false,
        "title": "家教首页",
        "group": "家教"
      }
    },
    {
      "path": "pages/index/user",
      "style": {
        "navigationBarTitleText": "我的",
        "enablePullDownRefresh": true
      },
      "meta": {
        "auth": false,
        "title": "我的",
        "group": "家教"
      }
    },
    {
      "path": "pages/index/login",
      "style": {
        "navigationBarTitleText": "登录"
      }
    }
  ],
  "subPackages": [
    {
      "root": "pages/tutor",
      "pages": [
        {
          "path": "city/index",
          "style": {
            "navigationBarTitleText": "选择城市"
          },
          "meta": {
            "auth": false,
            "title": "家教城市选择",
            "group": "家教"
          }
        },
        {
          "path": "identity/index",
          "style": {
            "navigationBarTitleText": "家教身份"
          },
          "meta": {
            "auth": true,
            "title": "家教身份",
            "group": "家教"
          }
        }
      ]
    },
    {
      "root": "pages/user",
      "pages": [
        {
          "path": "info",
          "style": {
            "navigationBarTitleText": "我的信息"
          },
          "meta": {
            "auth": true,
            "title": "我的信息",
            "group": "用户中心"
          }
        },
        {
          "path": "wallet/score",
          "style": {
            "navigationBarTitleText": "我的积分"
          },
          "meta": {
            "auth": true,
            "title": "我的积分",
            "group": "用户中心"
          }
        }
      ]
    },
    {
      "root": "pages/public",
      "pages": [
        {
          "path": "setting",
          "style": {
            "navigationBarTitleText": "系统设置"
          },
          "meta": {
            "title": "系统设置",
            "group": "通用"
          }
        },
        {
          "path": "richtext",
          "style": {
            "navigationBarTitleText": "富文本"
          },
          "meta": {
            "title": "富文本",
            "group": "通用"
          }
        },
        {
          "path": "faq",
          "style": {
            "navigationBarTitleText": "常见问题"
          },
          "meta": {
            "title": "常见问题",
            "group": "通用"
          }
        },
        {
          "path": "error",
          "style": {
            "navigationBarTitleText": "错误页面"
          }
        },
        {
          "path": "webview",
          "style": {
            "navigationBarTitleText": ""
          }
        }
      ]
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "家教",
    "navigationBarBackgroundColor": "#FFFFFF",
    "backgroundColor": "#FFFFFF",
    "navigationStyle": "custom",
    "mp-alipay": {
      "titleImage": "",
      "gestureBack": "YES",
      "allowsBounceVertical": "NO",
      "transparentTitle": "always",
      "navigationStyle": "custom",
      "titlePenetrate": "YES"
    }
  },
  "tabBar": {
    "list": [
      {
        "pagePath": "pages/index/index"
      },
      {
        "pagePath": "pages/index/user"
      }
    ]
  }
}
